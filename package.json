{
  "name": "@ununu/unutv-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:tunnel",
    "dev:tunnel": "node scripts/dev-with-tunnel.mjs",
    "dev:local-only": "npm --workspace @ununu/unutv-web run dev",
    "dev:api": "npm --workspace @ununu/unutv-api run dev",
    "dev:web": "npm --workspace @ununu/unutv-web run dev",
    "start": "npm run dev:tunnel",
    "start:local-only": "npm --workspace @ununu/unutv-web run start",
    "build": "npm --workspace @ununu/unutv-web run build",
    "test": "node --test tests/*.test.mjs",
    "verify:arch": "node scripts/check-architecture.mjs",
    "verify": "npm run test && npm run verify:arch && npm run build"
  },
  "engines": {
    "node": ">=26"
  },
  "overrides": {
    "postcss": "8.5.10"
  }
}
